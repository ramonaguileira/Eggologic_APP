# Copiá este archivo como .env y completá los valores.
# El .env nunca se sube al repo (está en .gitignore).

# Clave secreta de Django: una cadena larga y aleatoria. Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL. Si DB_NAME queda vacío, la app usa SQLite (archivo db.sqlite3).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Datos que ve el cliente si elige pagar por transferencia.
TIENDA_DATOS_TRANSFERENCIA=Te enviamos los datos para transferir por WhatsApp.

# Guardian (MGS, testnet). Los valores los tiene Ramón; nunca se suben al repo.
GUARDIAN_URL=https://guardianservice.app/api/v1
GUARDIAN_POLICY_ID=
# Usuario de Eggologic con rol Project_Proponent.
GUARDIAN_PROPONENTE_EMAIL=
GUARDIAN_PROPONENTE_PASSWORD=
# Un par por restaurante, con su código sin guion (R-001 -> R001). Rol Project_Participating_Entity.
GUARDIAN_R001_EMAIL=
GUARDIAN_R001_PASSWORD=
